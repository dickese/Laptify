# Database Config
DB_URL=jdbc:mariadb://localhost:3306/laptify_db
DB_USERNAME=root
DB_PASSWORD=root

# Security Config
JWT_SECRET_KEY=your_secret_key_here
JWT_ISSUER=Laptify
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# Media Config
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment - VNPay
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/callback

# Payment - MoMo
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment-result
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/callback
MOMO_REQUEST_TYPE=captureWallet

# Payment - ZaloPay
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=your_key1
ZALOPAY_KEY2=your_key2
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=http://localhost:8080/api/v1/payments/zalopay/callback
ZALOPAY_REDIRECT_URL=http://localhost:5173/payment-result